# Minimal testing container for CI with make and other testing utilities.
# Reference this as an example for how to copy make-mcp into your own dev containers.
ARG MAKE_MCP_IMAGE=ghcr.io/aidanhall34/make-mcp:latest
FROM ${MAKE_MCP_IMAGE} AS mcp

FROM alpine:3.21
# Install make, echo (part of coreutils or busybox), and wget for healthchecks.
# Integration tests might need these on the path.
RUN apk add --no-cache make coreutils wget curl

# Copy the make-mcp binaries from the scratch image.
COPY --from=mcp /make-mcp /usr/local/bin/make-mcp
COPY --from=mcp /make-mcp-validate /usr/local/bin/make-mcp-validate

# Default config path used in integration tests.
WORKDIR /opt/make-mcp
ENTRYPOINT ["/usr/local/bin/make-mcp"]
CMD ["--config", "make-mcp.yml", "--makefile", "makefile"]
